# Development API Configuration
DATABASE_PATH=construction.db
JWT_SECRET_KEY=DevelopmentJWTKey2024!ForTestingOnly
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# CORS - Allow all localhost variants for development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000

# Sync Configuration for Development API Server
SYNC_ENABLED=true
SYNC_SERVER_URL=http://localhost:8000
SYNC_NODE_CODE=API-SERVER-DEV
SYNC_COMPRESSION_ENABLED=true
SYNC_CONFLICT_RESOLUTION=server_wins
SYNC_DEBUG_LOGGING=true
SYNC_LOG_LEVEL=DEBUG
SYNC_AUTO_SYNC=false
SYNC_SYNC_INTERVAL=300
SYNC_BATCH_SIZE=100
SYNC_VERSION_HISTORY=true

# Database Configuration - SQLite for development
DATABASE_TYPE=sqlite
DATABASE_SQLITE_PATH=construction.db
DATABASE_CONNECTION_STRING=sqlite:///construction.db

# Development Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin