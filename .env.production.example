# Production Environment Configuration
# Copy this file to .env.production and customize for your environment

# Database Configuration (choose one)
# PostgreSQL (recommended)
DATABASE_URL=postgresql://postgres:secure_password@postgres-prod:5432/construction_prod
POSTGRES_DB=construction_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password
POSTGRES_PORT=5432

# MySQL (alternative)
# DATABASE_URL=mysql+pymysql://ctm_user:secure_password@mysql-prod:3306/construction_prod
# MYSQL_DATABASE=construction_prod
# MYSQL_USER=ctm_user
# MYSQL_PASSWORD=secure_password
# MYSQL_ROOT_PASSWORD=secure_root_password
# MYSQL_PORT=3306

# API Server Configuration
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-here-change-this
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
API_PORT=8000
LOG_LEVEL=INFO

# Web Client Configuration
WEB_PORT=80
WEB_HTTPS_PORT=443

# Redis Configuration (optional)
REDIS_PASSWORD=redis_password
REDIS_PORT=6379

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin_password

# SSL Configuration (for HTTPS)
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# Security Configuration
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# Performance Configuration
WORKERS=4
MAX_CONNECTIONS=100
TIMEOUT=30

# Logging Configuration
LOG_FORMAT=json
LOG_FILE=/app/logs/api.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5